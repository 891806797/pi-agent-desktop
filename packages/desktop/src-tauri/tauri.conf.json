{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Agent",
  "version": "0.1.0",
  "identifier": "com.pi-agent.desktop",
  "build": {
    "beforeBuildCommand": "bun run scripts/prepare.ts --frontend",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pi Agent",
        "width": 1280,
        "height": 850,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://asset.localhost asset:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/pi-agent-sidecar"
    ],
    "resources": {
      "resources/photon_rs_bg.wasm": "photon_rs_bg.wasm"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
